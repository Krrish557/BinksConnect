# Server
PORT=5000
JWT_SECRET=change-this-to-a-random-secret

# Email (Gmail SMTP). Use a Gmail "App Password" for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=BinksConnect <your-email@gmail.com>
# Set to "true" to log the full SMTP conversation (useful for debugging, noisy)
SMTP_DEBUG=false

# Client URL used to build password-reset links
# CLIENT_URL=http://localhost:3000

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOCATOR_STRATEGY=round_robin

# Sudo: Your Telegram user ID (get it from @userinfobot)
SUDO_USER_ID=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Turso (SQLite-compatible cloud DB)
# Sign up at https://turso.tech, create a database, then set these:
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-auth-token-here

# Optional: Add channels via API after bot setup
# POST /api/admin/channels { "channel_id": "-1001234567890", "title": "Storage-01" }

# Keep-alive: Set this to your Render backend URL to prevent idle spin-down
# The server will ping itself every 5 minutes
RENDER_URL=
PING_URL=